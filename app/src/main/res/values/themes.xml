<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BikeFront" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme_BikeFront_BottomDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/BikeFrontBottomDialogAnimation</item>
    </style>

    <style name="BikeFrontBottomDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

</resources>
